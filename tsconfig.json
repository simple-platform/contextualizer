{
  "compilerOptions": {
    // --- Environment & Modules ---
    "lib": [
      "ESNext"
    ],

    // eslint-disable-next-line jsonc/sort-keys
    "target": "ESNext",

    // eslint-disable-next-line jsonc/sort-keys
    "module": "ESNext", // Using ESNext is standard for modern Node/Bun CLIs

    "moduleDetection": "force",

    // eslint-disable-next-line jsonc/sort-keys
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,

    // eslint-disable-next-line jsonc/sort-keys
    "verbatimModuleSyntax": true,

    // eslint-disable-next-line jsonc/sort-keys
    "noEmit": true,

    // --- Strictness & Best Practices ---
    "strict": true,

    // eslint-disable-next-line jsonc/sort-keys
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,

    // eslint-disable-next-line jsonc/sort-keys
    "noUncheckedIndexedAccess": true,

    "noImplicitOverride": true,

    // --- Developer Experience Enhancements ---
    // eslint-disable-next-line jsonc/sort-keys
    "baseUrl": ".",

    // eslint-disable-next-line jsonc/sort-keys
    "paths": {
      "@/*": [
        "src/*"
      ] // Allows clean imports like '@/config/loader'
    },

    // --- Bun-specific types ---

    // eslint-disable-next-line jsonc/sort-keys
    "types": [
      "bun"
    ]
  },

  "include": [
    "src"
  ]
}
